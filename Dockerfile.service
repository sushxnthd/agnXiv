FROM python:3.11.17-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# The digest-pinned base is necessary for provenance, but its Debian package
# snapshot may age after publication. Apply fixed security packages at build
# time and fail closed if the repository cannot provide the first version that
# fixes CVE-2026-84782.
RUN apt-get update && \
    apt-get install --yes --no-install-recommends --only-upgrade openssl libssl3 && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' openssl)" ge "3.0.22-1~deb12u2" && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libssl3)" ge "3.0.22-1~deb12u2" && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system agnxiv && useradd --system --gid agnxiv --create-home agnxiv

WORKDIR /app

COPY pyproject.toml README.md LICENSE alembic.ini constraints-service.txt ./
COPY src ./src
COPY migrations ./migrations

RUN python -m pip install "pip==26.2.1" && \
    python -m pip install -c constraints-service.txt ".[service,sign,pdf]" && \
    python -m pip check && \
    python -m pip uninstall -y pip setuptools wheel

USER agnxiv

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn agnxiv.service.app:app --host 0.0.0.0 --port ${PORT:-8000} --forwarded-allow-ips=''"]
