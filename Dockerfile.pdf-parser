FROM python:3.11.17-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY constraints-service.txt ./
COPY src ./src

RUN python -m pip install "pip==26.2.1" && \
    python -m pip install -c constraints-service.txt \
      "pydantic==2.14.1" \
      "pypdf==6.21.1" && \
    python -m pip check && \
    python -c "import agnxiv.pdf_extract_worker, pydantic, pypdf" && \
    python -m pip uninstall -y setuptools wheel pip

USER 65534:65534

ENTRYPOINT ["python", "-m", "agnxiv.pdf_extract_worker"]
