DATABASE_URL=postgresql+psycopg://user:password@host:5432/agnxiv
AGNXIV_API_KEYS=replace-with-at-least-32-random-characters
AGNXIV_PUBLIC_BASE_URL=https://agnxiv.example.com
AGNXIV_GITHUB_TOKEN=github-token-with-actions-write-on-agnxiv-repo
AGNXIV_GITHUB_REPOSITORY=sushxnthd/agnXiv
AGNXIV_GITHUB_REF=refs/tags/agnxiv-release-<version>
AGNXIV_GITHUB_WORKFLOW=hosted-verify.yml
AGNXIV_GITHUB_WORKFLOW_SHA=40-char-release-commit-sha
AGNXIV_OIDC_AUDIENCE=https://agnxiv.example.com/github-actions
AGNXIV_ISSUER_PRIVATE_KEY_B64=base64-encoded-ed25519-private-pem
AGNXIV_ISSUER_PREVIOUS_PUBLIC_KEYS_B64=
AGNXIV_MAX_ACTIVE_JOBS_PER_KEY=3
AGNXIV_MAX_JOBS_PER_HOUR=20
AGNXIV_JOB_STALE_MINUTES=45
AGNXIV_MIN_API_KEY_LENGTH=32
AGNXIV_MAX_REQUEST_BYTES=5242880
